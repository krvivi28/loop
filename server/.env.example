# ---- Server ----
NODE_ENV=development
PORT=4000

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/fitstack   (or `docker compose up -d` from the project root)
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitstack
MONGODB_URI=mongodb://127.0.0.1:27017/fitstack

# ---- Auth ----
# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_DAYS=30
# Used when a user types a 10-digit number without +country code
DEFAULT_COUNTRY_CODE=91

# ---- SMS for login codes ----
# console = code is printed in this terminal (for local development)
# twilio  = real SMS via Twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- OpenAI (paste the key from the file on your desktop) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed if the client runs on a different origin than the API (not needed with the Vite proxy)
CLIENT_ORIGIN=

# ---- Google sign-in (optional) ----
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Web application
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
